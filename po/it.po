msgid ""
"For headphones: each ear hears a little of the other channel, as with "
"speakers"
msgstr ""
"Per le cuffie: ogni orecchio sente un po’ dell’altro canale, come con le "
"casse"

#: src/Windows/EqualizerWindow.vala:281
msgid "Echo delay"
msgstr "Ritardo dell’eco"

#: src/Windows/EqualizerWindow.vala:281
msgid "Time between the repeats"
msgstr "Tempo tra le ripetizioni"

#: src/Windows/EqualizerWindow.vala:282
msgid "Echo feedback"
msgstr "Retroazione dell’eco"

#: src/Windows/EqualizerWindow.vala:282
msgid "How many repeats are heard, fading"
msgstr "Quante ripetizioni si sentono, in dissolvenza"

