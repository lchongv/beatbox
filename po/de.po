msgstr ""
"Eine Obergrenze für die Spitzen, damit laute Stellen nicht übersteuern"

#: src/Windows/EqualizerWindow.vala:266
msgid "Compressor"
msgstr "Kompressor"

#: src/Windows/EqualizerWindow.vala:266
msgid "Holds down the loudest parts, for an even level"
msgstr "Drückt die lautesten Stellen herunter, für einen gleichmäßigen Pegel"

#: src/Windows/EqualizerWindow.vala:267
msgid "Chorus"
msgstr "Chorus"

#: src/Windows/EqualizerWindow.vala:267
