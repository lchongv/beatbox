msgstr "Verbreitert das Stereobild"

#: src/Windows/EqualizerWindow.vala:264
msgid "Saturation"
msgstr "Sättigung"

#: src/Windows/EqualizerWindow.vala:264
msgid "Warmth, with a little distortion"
msgstr "Wärme mit etwas Verzerrung"

#: src/Windows/EqualizerWindow.vala:265
msgid "Limiter"
msgstr "Limiter"

#: src/Windows/EqualizerWindow.vala:265
